# Relay proxy environment. Copy to /etc/relay/relay.env and edit.
# Every sshpiperd / relay-admind flag has an env var; these are the common ones.
# All paths must be writable by the service user (see relay-proxy.service).

# --- proxy (sshpiperd) ---
# Listening port. The proxy answers on every external IP of the host on this
# port, so the host's own administration sshd must NOT also use it: move the
# host sshd to another port or another address first.
SSHPIPERD_PORT=22

# SQLite registry (entries, personas, events). Created 0600 if missing.
SSHPIPERD_REGISTRY=/var/lib/relay/registry.db

# Structured audit (JSONL + asciicast + file copies), or empty to disable.
SSHPIPERD_AUDIT_DIR=/var/lib/relay/audit
SSHPIPERD_SENSOR_NAME=

# Open the backend connection from the client's source port, and announce the
# client's own version to the backend (instead of SSH-2.0-Go).
SSHPIPERD_PRESERVE_SOURCE_PORT=true
SSHPIPERD_COPY_CLIENT_VERSION=true

# Comma-separated external IPs to add to the interface at start (see
# run-proxy.sh / ExecStartPre). One external IP = one entry = one backend.
RELAY_EXTERNAL_IPS=
RELAY_EXTERNAL_IFACE=eth0

# --- registration API (relay-admind) ---
RELAY_ADMIN_ADDRESS=127.0.0.1:8090
RELAY_ADMIN_TLS_CERT=/etc/relay/admind.crt
RELAY_ADMIN_TLS_KEY=/etc/relay/admind.key
RELAY_ADMIN_TOKEN_FILE=/etc/relay/admind.token
